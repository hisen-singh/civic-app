rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ─── ISSUES ─────────────────────────────────────────────────────────────
    match /issues/{issueId} {
      // Anyone signed in can read issues
      allow read: if isSignedIn();

      // Only signed-in users can create – must provide their own authorId
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200;

      // Authors and admins can update; voters/solvers can update their own reactions
      allow update: if isSignedIn()
        && (
          isAdmin() ||
          (
            request.auth.uid == resource.data.authorId &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'statusUpdatedAt', 'commentsCount', 'afterPhoto', 'votes',
                         'voters', 'solvers', 'recentActivity', 'trendingScore', 'shareCount',
                         'viewCount', 'photoUrl', 'videoUrl'])
          ) ||
          (
            // Any signed-in user can vote (add themselves to voters) or react
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['votes', 'voters', 'solvers', 'status', 'statusUpdatedAt',
                         'commentsCount', 'recentActivity'])
            &&
            // Validate votes increment (+1 only)
            (
              !('votes' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.votes == resource.data.votes + 1 &&
                request.resource.data.voters.hasAll(resource.data.voters) &&
                request.resource.data.voters.size() == resource.data.voters.size() + 1 &&
                request.resource.data.voters.hasAny([request.auth.uid]) &&
                !resource.data.voters.hasAny([request.auth.uid])
              )
            )
            &&
            // Validate solvers increment (+1 only)
            (
              !('solvers' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.solvers.hasAll(resource.data.solvers) &&
                request.resource.data.solvers.size() == resource.data.solvers.size() + 1 &&
                request.resource.data.solvers.hasAny([request.auth.uid]) &&
                !resource.data.solvers.hasAny([request.auth.uid])
              )
            )
            &&
            // Valid status transitions:
            // Author: can set to Solved/Failed
            // Solver joining: can set to In Progress
            (
              request.resource.data.status == resource.data.status ||
              (request.resource.data.status == 'In Progress' && 'solvers' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.status in ['Solved', 'Failed'] &&
                request.auth.uid == resource.data.authorId
              )
            )
            &&
            // Comments count increment
            (
              !('commentsCount' in request.resource.data.diff(resource.data).affectedKeys()) ||
              request.resource.data.commentsCount == resource.data.commentsCount + 1
            )
            &&
            // recentActivity can be incremented by reactions
            (
              !('recentActivity' in request.resource.data.diff(resource.data).affectedKeys()) ||
              request.resource.data.recentActivity == resource.data.recentActivity + 5
            )
            &&
            // Legacy anonymous issues have no provable owner, so clients may
            // only vote and bump comment counters on them. Joins, solver-list
            // edits and status changes must go through admins/Cloud Functions.
            (
              resource.data.authorId != 'anonymous' ||
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['votes', 'voters', 'commentsCount', 'recentActivity'])
            )
          )
        );

      // Only author or admin can delete
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      // ── Reactions subcollection ──────────────────────────────────────────
      match /reactions/{userId} {
        allow read: if isSignedIn();
        // Users can add/remove their own reaction
        allow create: if isSignedIn() && request.auth.uid == userId
          && request.resource.data.type in ['support', 'solve', 'help', 'awareness'];
        allow delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if false; // Don't allow changing reaction type
      }

      // ── Comments subcollection ───────────────────────────────────────────
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if isAdmin() || isOwner(resource.data.authorId);
      }
    }

    // ─── ARCHIVED ISSUES ───────────────────────────────────────────────────
    match /archivedIssues/{issueId} {
      allow read: if isSignedIn();
      allow write: if false; // only backend
    }

    // ─── USERS ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      // Users can write their own profile, but NOT computed fields
      allow write: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'trustScore', 'rank', 'reported', 'solved', 'impactScore',
          'followerCount', 'followingCount', 'issueCount', 'solveCount'
        ]);

      // ── Followers subcollection (who follows this user) ───────────────
      match /followers/{followerId} {
        allow read: if isSignedIn();
        // Anyone can follow (create doc), can unfollow (delete doc)
        allow create: if isSignedIn() && request.auth.uid == followerId;
        allow delete: if isSignedIn() && request.auth.uid == followerId;
      }

      // ── Following subcollection (who this user follows) ──────────────
      match /following/{followingId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ─── USER FEED (written by functions, read by owner) ───────────────────
    match /userFeed/{userId}/timeline/{itemId} {
      allow read: if isOwner(userId);
      allow write: if false; // Cloud Functions only
    }

    // ─── WATCH AREAS ───────────────────────────────────────────────────────
    match /watchAreas/{areaId} {
      // Radius must be sane: 100m – 5km. Prevents one user subscribing to
      // city-wide notification zones with absurd radii.
      function validWatchRadius(r) {
        return r is number && r >= 100 && r <= 5000;
      }
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.userId
        && validWatchRadius(request.resource.data.radius);
      allow update, delete: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['radius']) ||
          validWatchRadius(request.resource.data.radius)
        );
    }

    // ─── NOTIFICATIONS ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Cloud Functions only
    }

    // ─── BADGES ─────────────────────────────────────────────────────────────
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if false; // Admin only via setAdminRole equivalent
    }

    // ─── USER BADGES ───────────────────────────────────────────────────────
    match /userBadges/{userId}/badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions only (achievement system)
    }

    // ─── LEADERBOARD ────────────────────────────────────────────────────────
    match /leaderboard/{period}/entries/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions only
    }
    match /leaderboard/city:{cityName}/entries/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions only
    }

    // ─── AUDIT LOGS ────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ─── FLAGGED CONTENT ───────────────────────────────────────────────────
    match /flaggedContent/{issueId}/flags/{flagId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string;
      allow update, delete: if false;
    }

  }
}
