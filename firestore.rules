rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // ─── ISSUES ─────────────────────────────────────────────────────────────
    match /issues/{issueId} {
      // Anyone signed in can read non-hidden issues; admins can read all
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.hidden != true);

      // Only verified users can create – must provide their own authorId
      allow create: if isEmailVerified()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200;

      // Only signed-in users can update – restrict which fields they can touch
      allow update: if isSignedIn()
        && (
          isAdmin() ||
          (
            request.auth.uid == resource.data.authorId && 
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'statusUpdatedAt', 'commentsCount', 'afterPhoto', 'votes', 'voters', 'solvers']) &&
            (!('afterPhoto' in request.resource.data) || (request.resource.data.afterPhoto is string && request.resource.data.afterPhoto.size() < 2000))
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['votes', 'voters', 'solvers', 'status', 'statusUpdatedAt', 'commentsCount'])
            &&
            // Validate Votes Increment
            (
              !('votes' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.votes == resource.data.votes + 1 &&
                request.resource.data.voters.hasAll(resource.data.voters) &&
                request.resource.data.voters.size() == resource.data.voters.size() + 1 &&
                request.resource.data.voters.hasAny([request.auth.uid]) &&
                !resource.data.voters.hasAny([request.auth.uid])
              )
            )
            &&
            // Validate Solvers Increment
            (
              !('solvers' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.solvers.hasAll(resource.data.solvers) &&
                request.resource.data.solvers.size() == resource.data.solvers.size() + 1 &&
                request.resource.data.solvers.hasAny([request.auth.uid]) &&
                !resource.data.solvers.hasAny([request.auth.uid])
              )
            )
            &&
            // Validate Status Change
            (
              request.resource.data.status == resource.data.status ||
              (request.resource.data.status == 'In Progress' && 'solvers' in request.resource.data.diff(resource.data).affectedKeys())
            )
            &&
            // Validate Comments Increment
            (
              !('commentsCount' in request.resource.data.diff(resource.data).affectedKeys()) ||
              (
                request.resource.data.commentsCount == resource.data.commentsCount + 1
              )
            )
          )
        );

      // Only the author or an admin can delete an issue
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
      
      // Comments Subcollection Rules
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isEmailVerified() 
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string 
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if isAdmin() || isOwner(resource.data.authorId);

        // Reports on comments
        match /reports/{reportId} {
          // Only verified users can report; one report per user enforced by using
          // the user's UID as the reportId on the client side
          allow create: if isEmailVerified()
            && request.resource.data.reporterId == request.auth.uid
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.reason.size() <= 500;
          allow read: if isAdmin();
          allow update, delete: if isAdmin();
        }
      }

      // Reports subcollection on issues
      match /reports/{reportId} {
        allow create: if isEmailVerified()
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 500;
        allow read: if isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // ─── ARCHIVED ISSUES (read-only) ────────────────────────────────────────
    match /archivedIssues/{issueId} {
      allow read: if isSignedIn();
      allow write: if false; // only backend can write
    }

    // ─── WATCH AREAS ────────────────────────────────────────────────────────
    match /watchAreas/{areaId} {
      // Users can only read/write their own watch areas
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isEmailVerified() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;
    }

    // ─── NOTIFICATIONS ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Users can only read their own notifications
      allow read: if isOwner(resource.data.userId);

      // Users can only mark their own notifications as read (update 'read' field only)
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // Only the backend (Cloud Functions) can create/delete notifications
      allow create, delete: if false;
    }

    // ─── USERS ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Full profile only visible to owner or admin
      allow read: if isOwner(userId) || isAdmin();

      // Users can only write their own doc (e.g. save FCM token, avatar)
      // trustScore, rank are managed exclusively by Cloud Functions
      allow write: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['trustScore', 'rank', 'reported', 'solved', 'isAdmin', 'adminGrantedAt']);

      // Public profile — safe fields readable by any signed-in user
      match /publicProfile/{docId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId)
          && !request.resource.data.keys().hasAny(['trustScore', 'rank', 'reported', 'solved', 'isAdmin']);
      }

      // Private User Data (FCM tokens, etc)
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── REPORTED CONTENT QUEUE (admin-only) ────────────────────────────────
    match /reportedContent/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── RATE LIMIT TRACKING (Cloud Functions only) ─────────────────────────
    match /userRateLimits/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // only Cloud Functions can write
    }

  }
}
